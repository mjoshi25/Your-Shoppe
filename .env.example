MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-password
APP_ADMIN_NAME=ASMJ Shoppe Admin
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
APP_PRODUCTS_REQUIRE_APPROVAL=true

# Optional: product approval gate
APP_PRODUCTS_REQUIRE_APPROVAL=true
SESSION_COOKIE_SECURE=true
# Server-side Google Maps Routes API key (never expose this in browser JavaScript)
GOOGLE_MAPS_API_KEY=your-restricted-routes-api-key

# Browser key restricted by HTTP referrer; enable Maps JavaScript API
GOOGLE_MAPS_BROWSER_API_KEY=
